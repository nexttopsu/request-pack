{
    "name": "request-pack",
    "version": "1.0.0",
    "description": "轻量爬虫工具包：HTTP 请求 / 并发任务池 / HTML 结构化解析",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "npm run build && tsx example.ts",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test test/parser.test.ts test/pool.test.ts test/utils.test.ts test/http.test.ts",
        "test:coverage": "tsx --test --experimental-test-coverage test/parser.test.ts test/pool.test.ts test/utils.test.ts test/http.test.ts",
        "test:smoke": "node test/smoke/compat.mjs",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "sideEffects": false,
    "keywords": [
        "crawler",
        "request",
        "worker",
        "task-pool",
        "html-parser",
        "utils"
    ],
    "author": "nexttopsu@gmail.com",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nexttopsu/request-pack.git"
    },
    "homepage": "https://github.com/nexttopsu/request-pack#readme",
    "bugs": {
        "url": "https://github.com/nexttopsu/request-pack/issues"
    },
    "engines": {
        "node": ">=18.17"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsup": "^9.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "cheerio": "~1.0.0",
        "iconv-lite": "^0.6.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
