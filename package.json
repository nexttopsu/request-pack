{
    "name": "request-pack",
    "version": "1.0.0",
    "description": "轻量爬虫工具包：HTTP 请求 / 并发任务池 / HTML 结构化解析",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "README.md"
    ],
    "scripts": {
        "dev": "tsx example.ts",
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/parser.test.ts test/pool.test.ts test/utils.test.ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "crawler",
        "request",
        "worker",
        "task-pool",
        "html-parser",
        "utils"
    ],
    "author": "nexttopsu@gmail.com",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nexttopsu/request-pack.git"
    },
    "homepage": "https://github.com/nexttopsu/request-pack#readme",
    "bugs": {
        "url": "https://github.com/nexttopsu/request-pack/issues"
    },
    "engines": {
        "node": ">=16"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "tsup": "^9.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "cheerio": "^1.0.0-rc.12",
        "iconv-lite": "^0.6.3"
    },
    "allowScripts": {
        "esbuild@0.21.5": true,
        "esbuild@0.27.7": true,
        "esbuild@0.28.2": true
    }
}
